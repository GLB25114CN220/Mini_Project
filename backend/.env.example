# Copy this file to ".env" for running on your own computer. NEVER upload the real ".env" to GitHub.
# On the hosting website (Render) these values are typed into its "Environment" page instead.
PORT=3000
JWT_SECRET=put-a-long-random-text-here-at-least-24-characters
ADMIN_EMAIL=admin@glbajaj.ac.in
ADMIN_PASSWORD=choose-a-strong-password

# College app database (a .sqlite/.db file with a "students" table, or a .csv export)
COLLEGE_DB_PATH=./college/sample_college_students.sqlite
COLLEGE_TABLE=students
COLLEGE_SYNC_MINUTES=5

# Where the website's own database file is kept (default: backend/dress.db).
# On a host with a persistent disk, point this to the disk, e.g. /var/data/dress.db
# DB_PATH=/var/data/dress.db
